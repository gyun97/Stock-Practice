# MySQL
MYSQL_HOST=mysql
MYSQL_DATABASE=stock
MYSQL_NAME=
MYSQL_PASSWORD=

# KIS API
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_REST_URL=https://openapivts.koreainvestment.com:29443
KIS_WS_URL=ws://ops.koreainvestment.com:31000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=your_jwt_secret

# OAuth 2.0
KAKAO_CLIENT_ID=your_kakao_id
KAKAO_CLIENT_SECRET=your_kakao_secret
KAKAO_REDIRECT_URL=http://localhost:8080/login/oauth2/code/kakao

NAVER_CLIENT_ID=your_naver_id
NAVER_CLIENT_SECRET=your_naver_secret
NAVER_REDIRECT_URL=http://localhost:8080/login/oauth2/code/naver
# Grafana Cloud
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=your_bucket_name_here
