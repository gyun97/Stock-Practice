logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------
// 1. Metrics (Prometheus) 수집 및 전송
// ---------------------------------------------------------

// Spring Boot 앱들로부터 메트릭을 스크레이핑합니다.
prometheus.scrape "stock_apps" {
  scrape_interval = "10s"
  metrics_path    = "/actuator/prometheus"
  targets = [
    {"__address__" = "app-blue:8080", "instance" = "stock-app-blue", "job" = "integrations/springboot"},
    {"__address__" = "app-green:8080", "instance" = "stock-app-green", "job" = "integrations/springboot"},
    {"__address__" = "app:8080", "instance" = "stock-app-local", "job" = "integrations/springboot"},
  ]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Grafana Cloud Prometheus로 메트릭 전송
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// ---------------------------------------------------------
// 2. Traces (Tempo) 수집 및 전송
// ---------------------------------------------------------

// 앱으로부터 OTLP 트레이스를 수신합니다. (포트 4317, 4318)
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// 트레이스 데이터를 효율적으로 배치 처리합니다.
otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.grafana_cloud.input]
  }
}

// Grafana Cloud Tempo로 트레이스 전송
// Grafana Cloud Tempo는 포트 443에서 gRPC + TLS를 요구합니다.
// tls 블록이 없으면 plain text로 연결을 시도하여 핸드셰이크에서 무조건 실패합니다.
otelcol.exporter.otlp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud.handler
    tls {
      insecure = false  // TLS 활성화 (Grafana Cloud 필수)
    }
  }
}

// gRPC 인증 설정 (비밀번호는 환경 변수에서 가져옴)
otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}

// ---------------------------------------------------------
// 3. Logs (Loki) 수집 및 전송
// ---------------------------------------------------------

// Docker 소켓을 통해 실행 중인 컨테이너들을 자동 검색합니다.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 수집할 컨테이너 로그에 메타데이터(컨테이너명 등)를 매핑합니다.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// 컨테이너 로그를 읽어서 Grafana Cloud Loki로 포워딩합니다.
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.filter_noise.receiver]
}

// 노이즈 로그 필터링 (로그 용량 절감)
loki.process "filter_noise" {
  // KIS 웹소켓 재연결 반복 에러 및 Logstash 연결 실패 로그 드롭
  stage.drop {
    expression  = "(?i)(Connection refused.*8081|Connection refused.*5044|재연결 이미 진행 중|Waiting [0-9]+ms before attempting reconnection|WebSocket 연결 끊김 감지)"
    drop_counter_reason = "noisy_reconnect_error"
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

// Grafana Cloud Loki로 로그 전송
loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
