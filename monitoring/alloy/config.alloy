logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------
// 1. Metrics (Prometheus) 수집 및 전송
// ---------------------------------------------------------

// Spring Boot 앱들로부터 메트릭을 스크레이핑합니다.
prometheus.scrape "stock_apps" {
  scrape_interval = "60s"
  metrics_path    = "/actuator/prometheus"
  targets = [
    {"__address__" = "app-blue:8080", "instance" = "stock-app-blue", "job" = "integrations/springboot"},
    {"__address__" = "app-green:8080", "instance" = "stock-app-green", "job" = "integrations/springboot"},
    {"__address__" = "app:8080", "instance" = "stock-app-local", "job" = "integrations/springboot"},
  ]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Grafana Cloud Prometheus로 메트릭 전송
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// ---------------------------------------------------------
// 2. Logs (Loki) 수집 및 전송
// ---------------------------------------------------------

// Docker 소켓을 통해 실행 중인 컨테이너들을 자동 검색합니다.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 수집할 컨테이너 로그에 메타데이터(컨테이너명 등)를 매핑합니다.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// 컨테이너 로그를 읽어서 Grafana Cloud Loki로 포워딩합니다.
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.grafana_cloud.receiver]
}

// Grafana Cloud Loki로 로그 전송
loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
